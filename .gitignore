# Generated by Cargo
# will have compiled files and executables
debug/
target/


# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Added by cargo

/target

# Generated reference artifacts for the merces end-to-end test
# (scripts/gen-merces-artifacts.sh) - large, and reproducible from that script.
/artifacts

# The merces proving keys (20-700 MB each, `just merces-zkeys`) - too large to commit;
# tests/merces.rs's proving tests skip with a message when this is absent.
/inputs/zkey

# Generated proving artifacts (scripts/gen-proving-artifacts.sh)
/kats/proving/*.zkey
/kats/proving/*.r1cs
/kats/proving/*-r1cs-info.txt

# merces-net party configs and TLS key/cert material - produced outside this repo
# (scripts/run-merces-net.sh)
/configs
/data

# circom dependencies (@taceo/circom-lib, circomlib), pulled via `pnpm -C circuits install`
/circuits/node_modules
